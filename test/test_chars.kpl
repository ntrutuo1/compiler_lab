PROGRAM CharTest;
CONST
    first_letter = 'A';
    last_letter = 'Z';
    digit_char = '0';
    special_char = '*';
VAR
    current_char, next_char: CHAR;
BEGIN
    current_char := 'B';
    next_char := 'C';
    
    IF current_char < next_char THEN
        CALL ProcessChars;
        
    current_char := first_letter;
    WHILE current_char <= last_letter DO
    BEGIN
        CALL PrintChar(current_char);
        current_char := CHR(ORD(current_char) + 1);
    END;
END.