PROGRAM NestedCommentTest;
(* Level 1 comment (* Level 2 comment (* Level 3 comment *) Level 2 continues *) Level 1 continues *)
VAR
    x, y: INTEGER;
BEGIN
    x := 5;
    (* Start outer (* Middle level (* Inner level *) Back to middle *) Back to outer *)
    y := x * 2;
    
    (*
        Multi-line with (* nested single line *) continue
        Another line (* another nest *) end
    *)
    
    IF x > y THEN
    BEGIN
        (* Simple comment in IF *)
        CALL ProcessData;
    END;
END.