PROGRAM SymbolTest;
VAR
    arr: ARRAY [1..10] OF INTEGER;
    i, j: INTEGER;
BEGIN
    i := 1;
    j := 1;
    
    WHILE i <= 10 DO
    BEGIN
        arr[(i)] := i * 2;
        i := i + 1;
    END;
    
    FOR i := 1 TO 10 DO
    BEGIN
        FOR j := 1 TO 10 DO
        BEGIN
            IF arr[i] > arr[j] THEN
                CALL SwapElements(arr, i, j);
        END;
    END;
END.