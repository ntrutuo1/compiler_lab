PROGRAM ComprehensiveTest;
CONST
    MAX_SIZE = 100;
    FIRST_CHAR = 'A';
    LAST_CHAR = 'Z';
TYPE
    NumberArray = ARRAY [1..MAX_SIZE] OF INTEGER;
    CharArray = ARRAY [1..26] OF CHAR;
VAR
    numbers: NumberArray;
    letters: CharArray;
    i, j, temp: INTEGER;
    found: BOOLEAN;
    current_char: CHAR;

(* Function to find maximum *)
FUNCTION FindMax(arr: NumberArray; size: INTEGER): INTEGER;
VAR
    i, max_val: INTEGER;
BEGIN
    max_val := arr[(1)];
    i := 2;
    WHILE i <= size DO
    BEGIN
        IF arr[(i)] > max_val THEN
            max_val := arr[(i)];
        i := i + 1;
    END;
    FindMax := max_val;
END;

BEGIN
    (* Initialize arrays *)
    i := 1;
    WHILE i <= MAX_SIZE DO
    BEGIN
        numbers[(i)] := i * 2;
        i := i + 1;
    END;
    
    current_char := FIRST_CHAR;
    i := 1;
    WHILE current_char <= LAST_CHAR DO
    BEGIN
        letters[(i)] := current_char;
        current_char := CHR(ORD(current_char) + 1);
        i := i + 1;
    END;
    
    (* Process data *)
    found := FALSE;
    i := 1;
    WHILE (i <= MAX_SIZE) AND (NOT found) DO
    BEGIN
        IF numbers[(i)] > 150 THEN
            found := TRUE
        ELSE
            i := i + 1;
    END;
    
    IF found THEN
    BEGIN
        temp := FindMax(numbers, MAX_SIZE);
        CALL DisplayResult(temp, letters[(i)]);
    END;
    
    (* Complex expression with all operators *)
    IF (numbers[(1)] + numbers[(2)] * numbers[(3)] / 2 > 100) AND 
       (letters[(5)] != 'X') OR (temp <= MAX_SIZE) THEN
        CALL FinalProcessing;
END.