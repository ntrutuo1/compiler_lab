PROGRAM IdentKeywordTest;
CONST
    max_value = 100;
TYPE
    array_type = ARRAY [1..10] OF INTEGER;
VAR
    counter, total_sum: INTEGER;
    my_array: array_type;
BEGIN
    counter := 0;
    total_sum := 0;
    WHILE counter < 10 DO
    BEGIN
        counter := counter + 1;
        total_sum := total_sum + counter;
    END;
    
    IF total_sum > max_value THEN
        CALL PrintMessage;
END.