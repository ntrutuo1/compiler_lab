program Example;

// Single-line comment

{ Multi-line
  comment test }

const
  x = 10;
  y = 20;

var
  a, b: integer;
  c: char;

function add(m, n: integer): integer;
begin
  return m + n;
end;

procedure show();
begin
  c := 'A';
  a := add(x, y);
end;

begin
  if a < b then
    a := a + 1
  else
    b := b - 1;

  while a < 100 do
    a := a + 10;

  call show();
end.
